# Postgres connection string (added automatically when you connect a Neon database in Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Password for /admin, where you read contact messages
ADMIN_PASSWORD=choose-a-long-password
# Optional: email notifications for new messages (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
